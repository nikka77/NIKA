# nika-audit.service — l'audit à l'aveugle hebdomadaire, côté VPS (24/7, PC de Dan éteint).
# Le CLI Claude vit sur le VPS depuis le 02/08 (jeton d'abonnement). Les rapports sortent du
# dépôt (NIKA_AUDIT_DIR) pour garder l'arbre git propre — le classement part sur WhatsApp.
[Unit]
Description=NIKA OPS — audit à l'aveugle hebdomadaire (Claude)
OnFailure=nika-echec@%n.service
[Service]
Type=oneshot
User=nika
WorkingDirectory=/home/nika/NIKA
Environment=NIKA_AUDIT_DIR=/home/nika/audits
ExecStart=/usr/bin/node --env-file=.env.local scripts/ops-audit-aveugle.mjs --par-couloir=6
Nice=10
