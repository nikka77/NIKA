# Secrétaire WhatsApp — équivalent systemd de com.nika.ops.secretaire (launchd).
[Unit]
OnFailure=nika-echec@%n.service
Description=NIKA OPS — secrétaire WhatsApp (file ops_chat)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=nika
WorkingDirectory=/home/nika/NIKA
ExecStart=/usr/bin/node --env-file=.env.local scripts/agent-worker.mjs --loop --chat --conc=2
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
