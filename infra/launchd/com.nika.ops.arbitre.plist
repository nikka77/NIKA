<?xml version="1.0" encoding="UTF-8"?>
<!-- Drainage des arbitrages Claude (litiges) toutes les 30 min — le CLI n'existe que sur le Mac.
     Mode drain : traite ce qui attend puis rend la main (pas de démon permanent). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nika.ops.arbitre</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-c</string>
    <string>cd ~/dev/NIKA && /opt/homebrew/bin/node --env-file=.env.local scripts/agent-worker.mjs --types=arbitrage_claude --conc=1 --lot=24</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>StandardOutPath</key><string>/tmp/nika-arbitre.log</string>
  <key>StandardErrorPath</key><string>/tmp/nika-arbitre.log</string>
</dict></plist>
