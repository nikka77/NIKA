# NIKA — variables d'environnement (exemple)
# En local : copier en `.env.local` et remplir. En prod : renseigner ces clés dans Vercel → Project → Settings → Environment Variables.

# ── Supabase (REQUIS) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic / NIKO (REQUIS) ──
ANTHROPIC_API_KEY=

# ── Stripe (REQUIS pour le wallet / crédits & commissions) ──
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Twilio (SMS pros — optionnel) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── APIs tierces (optionnel) ──
GOOGLE_PLACES_API_KEY=
# Carte livreur FOOD (DriverMap). MapLibre (carte principale) ne nécessite AUCUNE clé.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Affiliation Travelpayouts (liens STAY). Sans valeur → liens non monétisés.
NEXT_PUBLIC_TP_MARKER=
# Proxy résidentiel pour le scraping dispo Airbnb (scripts/scrape-availability.js).
# Si vide → connexion directe (test local). Si rempli → proxy mode scrape.do.
SCRAPEDO_TOKEN=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# E-mail admin (accès /admin + routes /api/admin). Défaut : dan@nika.fr
ADMIN_EMAIL=
